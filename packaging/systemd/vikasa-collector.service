# vikasa-collector as a systemd service. See docs/how-to/deploy-a-collector.md.
#
# This is a reference recipe, not the only supported way to run the
# collector: any supervisor that honours docs/reference/runtime-contract.md
# works (ADR 0023).
#
# The collector needs no privileges: it reads its config, talks SNMP (UDP) to
# devices on the cabinet network, connects to the local NATS, and serves the
# loopback management surface. Everything else is denied.
#
# Readiness: Type=notify. The collector sends READY=1 when the first device
# answers, the moment http://127.0.0.1:9471/readyz latches, so "active" means
# working, not merely running. Until then the unit is "activating" while the
# collector polls and reports normally; TimeoutStartSec=infinity keeps a
# cabinet whose devices are all down at boot running, reporting them
# unreachable, instead of being killed. `systemctl start` waits for READY=1;
# use --no-block to return at once.
#
# Watchdog: the collector pings while every device's poll loop is turning. A
# device that is down does not stop the pings; a hung collector does, and
# systemd restarts it.

[Unit]
Description=vikasa-collector (OpenITS cabinet edge collector)
Documentation=https://github.com/Vikasa2M/vikasa-collector
After=network-online.target
Wants=network-online.target
# The broker may start after us: the collector connects in the background
# and queues until it is up (ADR 0020), so this is ordering, not a hard dependency.
After=nats.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=infinity
WatchdogSec=60s
# The config holds SNMP community strings, so it is a secret: install it
# 0640 root:vikasa-collector, readable by root and this service only.
# For an authenticated or remote broker, add -nats-creds (and -nats-ca for a
# private CA); the .creds file is a secret like the config. See the deploy
# guide. Never put credentials in -nats: the collector refuses them.
ExecStart=/usr/local/bin/vikasa-collector -config /etc/vikasa-collector/collector.yaml -log-format json
Restart=on-failure
RestartSec=5s
# A clean stop drains for up to ~10s (state flush, publish drain, adapter close).
TimeoutStopSec=30s

# A static system user (see the deploy guide), not DynamicUser: the config is
# a secret that must be group-readable by exactly this service, and a dynamic
# user has no stable group to grant it to.
User=vikasa-collector
Group=vikasa-collector
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
